<Window x:Class="SetGame.LeaderboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SetGame"
        mc:Ignorable="d"
        Title="LeaderboardWindow" Height="450" Width="800" Background="#2b2d2f" ResizeMode="CanMinimize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="0.7*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Leaderboard" FontSize="45" VerticalAlignment="Bottom" 
                   HorizontalAlignment="Center" FontWeight="Bold" Foreground="#EEEEEE"/>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Orientation="Horizontal">
            <TextBlock Text="Filter:" FontSize="22" Foreground="#cfcfcf" VerticalAlignment="Center" Margin="10"/>
            <ComboBox Margin="10"/>
            <ComboBox Margin="10"/>
        </StackPanel>

        <ListView x:Name="leaderboard" VerticalAlignment="Top" HorizontalAlignment="Center" Grid.Row="2" 
                    Margin="30" FontSize="20" BorderBrush="Transparent" Background="#2b2d2f"
                  ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=PlayerName}" Header="Name"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=PlayerScore}" Header="Score"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=PlayersAmount}" Header="Players participating"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Time}" Header="Date"/>
                </GridView>
            </ListView.View>
            <ListView.Resources>

                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background" Value="#4b5d6f"/>
                    <Setter Property="Foreground" Value="#eeeeee"/>
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Style>

                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="#4b4d4f"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#cfcfcf"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="BorderThickness" Value="0"/>

                    <Style.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#5b5d5f"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#4b4d4f"/>
                            <Setter Property="Foreground" Value="#cfcfcf"/>
                        </Trigger>

                    </Style.Triggers>


                </Style>

            </ListView.Resources>
        </ListView>

    </Grid>
</Window>
